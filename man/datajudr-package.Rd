}\if{html}{\out{</div>}}

}
\item{\code{DATAJUD_BASE_URL}}{
URL base da API publica de consulta de processos (Elasticsearch).

\if{html}{\out{<div class="sourceCode">}}\preformatted{Valor padrao: `https://api-publica.datajud.cnj.jus.br`
}\if{html}{\out{</div>}}

}
\item{\code{DATAJUD_USER} / \code{DATAJUD_PWD}}{
Usuario e senha (Basic Auth) da API Elastic (\code{fonte = "elastic"}),
usados para os indices \verb{view-processos-sigilo-*} e \verb{datamart-*}.
Sao fornecidos pelo tribunal; nao ha valor padrao.

\if{html}{\out{<div class="sourceCode">}}\preformatted{Fonte: \url{https://datajud-wiki.cnj.jus.br/para-tribunais/Datajud/Api-elastic/}
}\if{html}{\out{</div>}}

